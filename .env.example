# Copy this file to .env for local development.
# On Railway, set these as project Variables instead (Settings > Variables) —
# do not upload a .env file there.

# Provided automatically by Railway's Postgres plugin. For local dev, point
# this at a local Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/sunflower_corners

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# Set to "production" on Railway. Leave unset (or "development") locally.
NODE_ENV=development

# Railway sets PORT automatically; only needed for local dev if you want a
# specific port.
PORT=3000
