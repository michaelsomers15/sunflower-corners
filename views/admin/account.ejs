<%- include('../partials/admin-header', { pageTitle: 'My Account' }) %>

<div class="admin-header-row">
  <h1>My Account</h1>
</div>

<% if (saved) { %><div class="alert alert-success">Password updated.</div><% } %>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card card-pad" style="max-width: 480px;">
  <h3 style="margin-top:0;">Change password</h3>
  <form class="stacked-form" method="POST" action="/admin/account/password">
    <div class="field">
      <label for="current_password">Current password</label>
      <input type="password" id="current_password" name="current_password" required autocomplete="current-password">
    </div>
    <div class="field">
      <label for="new_password">New password</label>
      <input type="password" id="new_password" name="new_password" required minlength="8" autocomplete="new-password">
      <span class="hint">At least 8 characters.</span>
    </div>
    <div class="field">
      <label for="confirm_password">Confirm new password</label>
      <input type="password" id="confirm_password" name="confirm_password" required minlength="8" autocomplete="new-password">
    </div>
    <button type="submit" class="btn btn-primary">Update Password</button>
  </form>
</div>

<%- include('../partials/admin-footer') %>
