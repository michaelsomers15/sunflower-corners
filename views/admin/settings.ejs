<%- include('../partials/admin-header', { pageTitle: 'Site Settings' }) %>

<div class="admin-header-row">
  <h1>Site Settings</h1>
</div>

<% if (saved) { %><div class="alert alert-success">Settings saved.</div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card card-pad">
  <form class="stacked-form" method="POST" action="/admin/settings" style="max-width: 700px;">

    <div class="field">
      <label for="farm_name">Farm / business name</label>
      <input type="text" id="farm_name" name="farm_name" value="<%= settings.farm_name %>">
    </div>

    <div class="field">
      <label for="tagline">Homepage tagline</label>
      <input type="text" id="tagline" name="tagline" value="<%= settings.tagline %>">
    </div>

    <div class="field">
      <label for="home_lede">Homepage intro paragraph</label>
      <textarea id="home_lede" name="home_lede" rows="3"><%= settings.home_lede %></textarea>
      <span class="hint">Shown under the headline on the homepage.</span>
    </div>

    <div class="row2">
      <div class="field">
        <label for="address_line1">Street address</label>
        <input type="text" id="address_line1" name="address_line1" value="<%= settings.address_line1 %>" placeholder="e.g. W1234 County Road X">
      </div>
      <div class="field">
        <label for="address_line2">City, state</label>
        <input type="text" id="address_line2" name="address_line2" value="<%= settings.address_line2 %>">
      </div>
    </div>

    <div class="row2">
      <div class="field">
        <label for="phone">Phone</label>
        <input type="tel" id="phone" name="phone" value="<%= settings.phone %>" placeholder="e.g. (715) 555-0123">
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= settings.email %>">
      </div>
    </div>

    <div class="field">
      <label for="facebook_url">Facebook URL (optional)</label>
      <input type="url" id="facebook_url" name="facebook_url" value="<%= settings.facebook_url %>" placeholder="https://facebook.com/...">
    </div>

    <div class="field">
      <label for="hours">Stand hours</label>
      <textarea id="hours" name="hours" rows="5"><%= settings.hours %></textarea>
      <span class="hint">One line per day or group of days, in the format "Days: Time". Example: "Mon-Fri: 9am - 5pm"</span>
    </div>

    <div class="field">
      <label for="products_intro">Products page intro</label>
      <textarea id="products_intro" name="products_intro" rows="3"><%= settings.products_intro %></textarea>
      <span class="hint">Shown at the top of the Products page, above the listings.</span>
    </div>

    <div class="field">
      <label for="coming_soon_label">"Coming soon" status wording</label>
      <input type="text" id="coming_soon_label" name="coming_soon_label" maxlength="30" value="<%= settings.coming_soon_label %>" placeholder="Coming Soon">
      <span class="hint">What the third stock status says on product tags — e.g. "Coming Soon", "Back Soon", "Harvesting Soon". Keep it short; it's printed on the stamp. Leave blank for "Coming Soon".</span>
    </div>

    <div class="field">
      <label for="amazon_tag">Amazon Associate tag</label>
      <input type="text" id="amazon_tag" name="amazon_tag" maxlength="64" value="<%= settings.amazon_tag %>" placeholder="e.g. sunflowercorn-20" autocomplete="off">
      <span class="hint">Your tracking ID from Amazon Associates Central (top-right corner, usually ends in "-20"). It's added to every amazon.com link on the Our Picks page so purchases are credited to you.</span>
    </div>

    <div class="field">
      <label for="picks_intro">"Our Picks" page intro</label>
      <textarea id="picks_intro" name="picks_intro" rows="2"><%= settings.picks_intro %></textarea>
      <span class="hint">Shown at the top of the Our Picks page. The required Amazon disclosure is always shown beneath it automatically.</span>
    </div>

    <div class="field">
      <label for="visit_note">Visit page note</label>
      <textarea id="visit_note" name="visit_note" rows="2"><%= settings.visit_note %></textarea>
      <span class="hint">Small note shown under the hours table on the Visit &amp; Contact page.</span>
    </div>

    <div class="field">
      <label for="about_text">About / farm story</label>
      <textarea id="about_text" name="about_text" rows="6"><%= settings.about_text %></textarea>
      <span class="hint">Shown on the homepage and the "Our Farm" page.</span>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Settings</button>
    </div>
  </form>
</div>

<%- include('../partials/admin-footer') %>
