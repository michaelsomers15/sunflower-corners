<%- include('../partials/admin-header', { pageTitle: 'Products' }) %>
<% var comingSoonLabel = (settings && settings.coming_soon_label && settings.coming_soon_label.trim()) || 'Coming Soon'; %>

<div class="admin-header-row">
  <div>
    <h1 style="margin-bottom:2px;">Products</h1>
    <p style="color: var(--ink-soft); margin:0;">Use a size's status dropdown to set it to In Stock, Sold Out, or <%= comingSoonLabel %> — it saves instantly. Use <strong>Visible</strong> to pull an entire product off the public site without deleting it.</p>
  </div>
  <a href="/admin/products/new" class="btn btn-primary">+ Add Product</a>
</div>

<div class="card">
  <% if (products.length === 0) { %>
    <div class="card-pad">
      <div class="empty-state">No products yet. Click "Add Product" to create your first listing.</div>
    </div>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Photo</th>
          <th>Name</th>
          <th>Category</th>
          <th>Sizes &amp; Stock</th>
          <th>Visible</th>
          <th>Updated</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(function(p) { %>
          <tr id="row-<%= p.id %>" class="<%= p.visible ? '' : 'row-hidden' %>">
            <td>
              <% if (p.photo) { %>
                <img class="thumb" src="/image/<%= p.id %>" alt="">
              <% } else { %>
                <span class="thumb-placeholder"></span>
              <% } %>
            </td>
            <td><strong><%= p.name %></strong></td>
            <td><%= p.category_name || '—' %></td>
            <td>
              <div class="status-stack">
                <% (p.variants || []).forEach(function(v) { %>
                  <div style="display:flex; align-items:center; gap:8px;">
                    <span class="mono" style="font-size:0.82rem; min-width:110px;"><%= v.label %> — $<%= Number(v.price).toFixed(2) %></span>
                    <select class="pill-toggle pill-select status-<%= v.status %>"
                      data-id="<%= v.id %>"
                      data-prev="<%= v.status %>"
                      aria-label="Stock status for <%= p.name %> <%= v.label %>"
                      onchange="setVariantStatus(this)">
                      <option value="in_stock" <%= v.status === 'in_stock' ? 'selected' : '' %>>In Stock</option>
                      <option value="sold_out" <%= v.status === 'sold_out' ? 'selected' : '' %>>Sold Out</option>
                      <option value="coming_soon" <%= v.status === 'coming_soon' ? 'selected' : '' %>><%= comingSoonLabel %></option>
                    </select>
                  </div>
                <% }); %>
              </div>
            </td>
            <td>
              <button type="button"
                class="pill-toggle <%= p.visible ? 'visible' : 'hidden' %>"
                data-id="<%= p.id %>"
                onclick="toggleVisible(this)">
                <%= p.visible ? 'Visible' : 'Hidden' %>
              </button>
            </td>
            <td class="mono" style="font-size:0.78rem; color: var(--ink-soft);"><%= formatLocal(p.updated_at) %></td>
            <td>
              <div class="row-actions">
                <a href="/admin/products/<%= p.id %>/edit" class="btn btn-dark btn-sm">Edit</a>
                <form method="POST" action="/admin/products/<%= p.id %>/delete" onsubmit="return confirm('Delete &quot;<%= p.name %>&quot;? This cannot be undone.');">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<script>
function applyStatusClass(sel, status) {
  sel.classList.remove('status-in_stock', 'status-sold_out', 'status-coming_soon');
  sel.classList.add('status-' + status);
}

async function setVariantStatus(sel) {
  const id = sel.dataset.id;
  const status = sel.value;
  sel.disabled = true;
  try {
    const res = await fetch('/admin/variants/' + id + '/status', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: status })
    });
    if (!res.ok) throw new Error('Request failed');
    const data = await res.json();
    sel.value = data.status;
    sel.dataset.prev = data.status;
    applyStatusClass(sel, data.status);
  } catch (e) {
    sel.value = sel.dataset.prev;
    applyStatusClass(sel, sel.dataset.prev);
    alert('Could not update stock status. Please try again.');
  } finally {
    sel.disabled = false;
  }
}

async function toggleVisible(btn) {
  const id = btn.dataset.id;
  btn.disabled = true;
  try {
    const res = await fetch('/admin/products/' + id + '/toggle-visible', { method: 'POST' });
    if (!res.ok) throw new Error('Request failed');
    const data = await res.json();
    const row = document.getElementById('row-' + id);
    if (data.visible) {
      btn.classList.remove('hidden'); btn.classList.add('visible'); btn.textContent = 'Visible';
      if (row) row.classList.remove('row-hidden');
    } else {
      btn.classList.remove('visible'); btn.classList.add('hidden'); btn.textContent = 'Hidden';
      if (row) row.classList.add('row-hidden');
    }
  } catch (e) {
    alert('Could not update visibility. Please try again.');
  } finally {
    btn.disabled = false;
  }
}
</script>

<%- include('../partials/admin-footer') %>
