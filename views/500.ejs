<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Something went wrong | Sunflower Corners</title>
<link rel="icon" href="/images/logo.png">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="login-shell">
  <div class="login-card" style="text-align:center;">
    <img src="/images/logo.png" alt="Sunflower Corners logo">
    <h1>Something went wrong</h1>
    <p style="color: var(--ink-soft); margin-bottom: 22px;">Give it another try, or check back shortly.</p>
    <% if (typeof message !== 'undefined' && message) { %><p class="mono" style="font-size:0.8rem; color: var(--rust);"><%= message %></p><% } %>
    <a href="/" class="btn btn-primary">Back to home</a>
  </div>
</div>
</body>
</html>
