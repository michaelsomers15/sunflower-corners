<%
// Expects a local `p`: a product row with .variants (array of
// {label, price, status}) and optionally .category_name.
// One variant renders like the classic single-price tag; more than one
// renders as a stacked size list, each with its own price and stock tag.
var variants = p.variants || [];
var comingSoonLabel = (typeof settings !== 'undefined' && settings.coming_soon_label && settings.coming_soon_label.trim()) || 'Coming Soon';
var STAMPS = {
  in_stock: { cls: 'in-stock', text: 'In Stock' },
  sold_out: { cls: 'out-of-stock', text: 'Sold Out' },
  coming_soon: { cls: 'coming-soon', text: comingSoonLabel }
};
function stampFor(v) { return STAMPS[v.status] || STAMPS.in_stock; }
%>
<div class="tag-card">
  <% if (p.photo) { %>
    <img class="tag-photo" src="/image/<%= p.id %>" alt="<%= p.name %>">
  <% } else { %>
    <div class="tag-photo-placeholder">No photo yet</div>
  <% } %>
  <div class="tag-body">
    <% if (p.category_name) { %><span class="tag-category"><%= p.category_name %></span><% } %>
    <h3><%= p.name %></h3>
    <p class="tag-desc"><%= p.description %></p>

    <% if (variants.length <= 1) { %>
      <% var v = variants[0] || { price: 0, label: 'each', status: 'in_stock' }; var st = stampFor(v); %>
      <div class="tag-footer">
        <span class="tag-price">$<%= Number(v.price).toFixed(2) %><span class="tag-unit"><%= v.label %></span></span>
        <span class="stamp <%= st.cls %>"><%= st.text %></span>
      </div>
    <% } else { %>
      <div class="variant-list">
        <% variants.forEach(function(v) { %>
          <div class="variant-row">
            <span class="variant-label"><%= v.label %></span>
            <span class="variant-price">$<%= Number(v.price).toFixed(2) %></span>
            <% var st = stampFor(v); %>
            <span class="stamp stamp-sm <%= st.cls %>"><%= st.text %></span>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>
